<script>
function normalizeText(str) {
    return str
        .toLowerCase()
        .trim()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[¡!¿?.,;:()]/g, "")
        .replace(/\s+/g, " ");
}

function checkAnswers() {
    const inputs = document.querySelectorAll('input[data-ans]');
    let total = inputs.length;
    let correctCount = 0;

    // Clear old hints
    document.querySelectorAll('.feedback-hint').forEach(el => el.remove());

    inputs.forEach(input => {
        const rawUser = input.value;
        const userNorm = normalizeText(rawUser);
        const acceptedList = input.getAttribute('data-ans').split('|').map(a => normalizeText(a));
        const displayAns = input.getAttribute('data-ans').split('|')[0];

        input.classList.remove('correct', 'incorrect');

        const hint = document.createElement('span');
        hint.className = 'feedback-hint';

        if (userNorm !== "" && acceptedList.includes(userNorm)) {
            input.classList.add('correct');
            hint.classList.add('ok');
            hint.textContent = "✓";
            correctCount++;
        } else {
            input.classList.add('incorrect');
            hint.textContent = "✗ (" + displayAns + ")";
        }
        input.insertAdjacentElement('afterend', hint);
    });

    // Reveal sample answers for open-ended Part 3
    document.querySelectorAll('.model-box').forEach(box => {
        box.style.display = 'block';
    });

    const pct = total > 0 ? Math.round((correctCount / total) * 100) : 0;
    const banner = document.getElementById('score-banner');
    banner.textContent = `Score: ${correctCount} / ${total} (${pct}%)`;
    banner.style.color = pct >= 80 ? '#16a34a' : (pct >= 50 ? '#d97706' : '#dc2626');
}

function resetWorksheet() {
    document.querySelectorAll('input[data-ans]').forEach(input => {
        input.value = '';
        input.classList.remove('correct', 'incorrect');
    });
    document.querySelectorAll('.open-input').forEach(input => {
        input.value = '';
    });
    document.querySelectorAll('.feedback-hint').forEach(el => el.remove());
    document.querySelectorAll('.model-box').forEach(box => {
        box.style.display = 'none';
    });
    const banner = document.getElementById('score-banner');
    banner.textContent = '';
}
</script>

