<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Positions, Subjects & Articles | Spanish for Footballers</title>
  <style>
:root {
  --bg: #0b1120;
  --surface: #111827;
  --surface-2: #1f2937;
  --border: #374151;
  --text: #f9fafb;
  --muted: #9ca3af;
  --accent: #10b981;
  --accent-hover: #059669;
  --wrong: #ef4444;
  --warn: #f59e0b;
}
* { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
body { background: var(--bg); color: var(--text); margin: 0; padding: 20px 16px 60px; line-height: 1.5; }
.container { max-width: 820px; margin: 0 auto; }
.header { background: linear-gradient(135deg, #064e3b 0%, #0f172a 100%); border: 1px solid #047857; border-radius: 14px; padding: 24px; margin-bottom: 20px; }
.badge { display: inline-block; background: rgba(16, 185, 129, 0.2); color: #34d399; font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 99px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
h1 { margin: 0 0 8px; font-size: 24px; }
.subtitle { margin: 0; color: #d1d5db; font-size: 14px; }
.nav-back { display: inline-block; color: #34d399; text-decoration: none; font-size: 14px; font-weight: 600; margin-bottom: 14px; }
.nav-back:hover { text-decoration: underline; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 18px; }
.card h2 { margin-top: 0; font-size: 18px; color: #34d399; border-bottom: 1px solid var(--border); padding-bottom: 10px; }
.rule-box { background: rgba(16, 185, 129, 0.08); border-left: 4px solid var(--accent); padding: 14px 16px; border-radius: 6px; margin-bottom: 16px; font-size: 14px; }
.player-bar { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media(max-width: 600px) { .player-bar { grid-template-columns: 1fr; } }
input[type="text"], textarea, select {
  background: var(--surface-2); border: 1px solid var(--border); color: var(--text);
  padding: 8px 12px; border-radius: 8px; font-size: 15px; width: 100%;
}
input[type="text"]:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); }
.inline-input { width: auto !important; min-width: 130px; max-width: 220px; display: inline-block; padding: 4px 10px !important; margin: 2px 4px; text-align: center; font-weight: 600; }
.q-item { padding: 12px 0; border-bottom: 1px solid #1f2937; }
.q-item:last-child { border-bottom: none; }
.q-label { font-weight: 500; margin-bottom: 6px; display: block; }
.feedback { font-size: 13px; margin-top: 6px; font-weight: 600; display: none; }
.feedback.ok { color: #34d399; display: block; }
.feedback.err { color: #f87171; display: block; }
.input-ok { border-color: #10b981 !important; background: rgba(16, 185, 129, 0.12) !important; }
.input-err { border-color: #ef4444 !important; background: rgba(239, 68, 68, 0.12) !important; }
.mc-options { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
.mc-btn { background: var(--surface-2); border: 1px solid var(--border); color: var(--text); padding: 7px 14px; border-radius: 8px; cursor: pointer; font-size: 14px; }
.mc-btn.selected { border-color: #60a5fa; background: rgba(59, 130, 246, 0.2); }
.mc-btn.ok { border-color: #10b981; background: rgba(16, 185, 129, 0.25); color: #a7f3d0; }
.mc-btn.err { border-color: #ef4444; background: rgba(239, 68, 68, 0.25); color: #fecaca; }
.actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
.btn { background: var(--accent); color: #06281e; border: none; padding: 12px 20px; border-radius: 10px; font-weight: 700; font-size: 15px; cursor: pointer; }
.btn:hover { background: var(--accent-hover); }
.btn-sec { background: var(--surface-2); color: var(--text); border: 1px solid var(--border); }
.btn-sec:hover { background: #374151; }
.score-banner { display: none; background: var(--surface-2); border: 2px solid var(--accent); border-radius: 12px; padding: 18px; margin-top: 20px; text-align: center; }
.score-num { font-size: 32px; font-weight: 800; color: #34d399; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media(max-width: 600px) { .grid-2 { grid-template-columns: 1fr; } }
.vocab-table { width: 100%; border-collapse: collapse; margin-bottom: 12px; font-size: 14px; }
.vocab-table th, .vocab-table td { border: 1px solid var(--border); padding: 8px 10px; text-align: left; }
.vocab-table th { background: var(--surface-2); color: #34d399; }
</style>
</head>
<body>
  <div class="container">
    <a href="index.html" class="nav-back">← Back to All Worksheets</a>
    <div class="header">
      <div class="badge">Level 1 • Foundations</div>
      <h1>Positions, Subjects & Articles</h1>
      <p class="subtitle">Master Spanish pitch positions, subject pronouns, and definite/indefinite articles.</p>
    </div>

    <div class="card">
      <div class="player-bar">
        <div>
          <label class="q-label">Player Name</label>
          <input type="text" id="playerName" placeholder="e.g., Alex Morgan" />
        </div>
        <div>
          <label class="q-label">Tutor Name</label>
          <input type="text" id="tutorName" placeholder="e.g., Erika" />
        </div>
      </div>
    </div>

    
<div class="card">
  <h2>Part 1: Pitch Positions (Las Posiciones)</h2>
  <div class="rule-box"><strong>Tip:</strong> Type the Spanish noun with or without the article (e.g., <em>portero</em> or <em>el portero</em>).</div>
  <div class="grid-2">
    
    <div class="q-item">
      <span class="q-label">1. GK (Goalkeeper) =</span>
      <input type="text" data-ans="portero|el portero|arquero|el arquero" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">2. CB (Center Back) =</span>
      <input type="text" data-ans="central|el central|defensa central|el defensa central" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">3. FB (Fullback) =</span>
      <input type="text" data-ans="lateral|el lateral" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">4. CDM (Defensive Midfielder) =</span>
      <input type="text" data-ans="pivote|el pivote|mediocentro defensivo|el mediocentro defensivo" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">5. CM (Central Midfielder) =</span>
      <input type="text" data-ans="mediocentro|el mediocentro|centrocampista|el centrocampista" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">6. CAM (Attacking Midfielder) =</span>
      <input type="text" data-ans="mediapunta|el mediapunta|enganche|el enganche" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">7. Striker =</span>
      <input type="text" data-ans="delantero|el delantero|delantero centro|el delantero centro" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">8. Winger =</span>
      <input type="text" data-ans="extremo|el extremo" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
  </div>
</div>

<div class="card">
  <h2>Part 2: Subject Pronouns (Los Pronombres)</h2>
  <div class="grid-2">
    
    <div class="q-item">
      <span class="q-label">9. I =</span>
      <input type="text" data-ans="yo" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">10. You (informal singular) =</span>
      <input type="text" data-ans="tu|tú" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">11. He =</span>
      <input type="text" data-ans="el|él" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">12. She =</span>
      <input type="text" data-ans="ella" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">13. They (masculine/mixed) =</span>
      <input type="text" data-ans="ellos" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">14. We =</span>
      <input type="text" data-ans="nosotros|nosotras" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">15. You Guys (Spain / LatAm) =</span>
      <input type="text" data-ans="vosotros|ustedes|vosotros / ustedes" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
  </div>
</div>

<div class="card">
  <h2>Part 3: Definite & Indefinite Articles</h2>
  <div class="rule-box">Spanish articles match <strong>gender</strong> (masculine/feminine) and <strong>number</strong> (singular/plural).</div>
  <div class="grid-2">
    
    <div class="q-item">
      <span class="q-label">16. The (masculine singular — e.g., ___ balón) =</span>
      <input type="text" data-ans="el" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">17. The (feminine singular — e.g., ___ portería) =</span>
      <input type="text" data-ans="la" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">18. The (masculine plural — e.g., ___ jugadores) =</span>
      <input type="text" data-ans="los" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">19. The (feminine plural — e.g., ___ botas) =</span>
      <input type="text" data-ans="las" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">20. A / An (masculine singular — e.g., ___ gol) =</span>
      <input type="text" data-ans="un" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">21. A / An (feminine singular — e.g., ___ falta) =</span>
      <input type="text" data-ans="una" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">22. Some / A few (masculine plural — e.g., ___ pases) =</span>
      <input type="text" data-ans="unos" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
    
    <div class="q-item">
      <span class="q-label">23. Some / A few (feminine plural — e.g., ___ tarjetas) =</span>
      <input type="text" data-ans="unas" placeholder="Type Spanish answer..." />
      <div class="feedback"></div>
    </div>
  </div>
</div>


    <div class="actions">
      <button class="btn" onclick="gradeWorksheet()">Check My Answers</button>
      <button class="btn btn-sec" onclick="copyResults()">Copy Results for Tutor</button>
    </div>

    <div id="scoreBanner" class="score-banner">
      <div>Auto-Graded Score</div>
      <div id="scoreText" class="score-num">0 / 0</div>
      <p style="color: #9ca3af; font-size: 14px; margin: 8px 0 0;">Click <strong>Copy Results for Tutor</strong> above and send it via WhatsApp or email.</p>
    </div>
  </div>
  <script>
function normalize(str) {
  return (str || "")
    .toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[¡!¿?.,;:()]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

document.querySelectorAll('.mc-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const group = btn.parentElement;
    group.querySelectorAll('.mc-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
  });
});

function gradeWorksheet() {
  const title = document.title.split('|')[0].trim();
  let total = 0;
  let correct = 0;
  let missed = [];

  document.querySelectorAll('[data-ans]').forEach((el) => {
    total++;
    const userVal = normalize(el.value);
    const validAnswers = el.getAttribute('data-ans').split('|').map(a => normalize(a));
    const displayAns = el.getAttribute('data-ans').split('|')[0];
    const fb = el.parentElement.querySelector('.feedback') || el.closest('.q-item')?.querySelector('.feedback');
    
    el.classList.remove('input-ok', 'input-err');
    if (userVal && validAnswers.includes(userVal)) {
      correct++;
      el.classList.add('input-ok');
      if (fb) { fb.textContent = "✓ Correct!"; fb.className = "feedback ok"; }
    } else {
      el.classList.add('input-err');
      missed.push("Q" + total + " (Expected: " + displayAns + ")");
      if (fb) { fb.textContent = "✗ Answer: " + displayAns; fb.className = "feedback err"; }
    }
  });

  document.querySelectorAll('[data-mc-ans]').forEach((group) => {
    total++;
    const expected = normalize(group.getAttribute('data-mc-ans'));
    const displayAns = group.getAttribute('data-mc-ans');
    const selected = group.querySelector('.mc-btn.selected');
    const fb = group.parentElement.querySelector('.feedback');

    group.querySelectorAll('.mc-btn').forEach(b => b.classList.remove('ok', 'err'));

    if (selected && normalize(selected.textContent) === expected) {
      correct++;
      selected.classList.add('ok');
      if (fb) { fb.textContent = "✓ Correct!"; fb.className = "feedback ok"; }
    } else {
      if (selected) selected.classList.add('err');
      group.querySelectorAll('.mc-btn').forEach(b => {
        if (normalize(b.textContent) === expected) b.classList.add('ok');
      });
      missed.push("Q" + total + " (Expected: " + displayAns + ")");
      if (fb) { fb.textContent = "✗ Answer: " + displayAns; fb.className = "feedback err"; }
    }
  });

  const pct = total > 0 ? Math.round((correct / total) * 100) : 100;
  const banner = document.getElementById('scoreBanner');
  document.getElementById('scoreText').textContent = `${correct} / ${total} (${pct}%)`;
  banner.style.display = 'block';
  banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

  window._lastResult = { title, correct, total, pct, missed };
}

function copyResults() {
  if (!window._lastResult) {
    alert("Click 'Check My Answers' first so your score is calculated!");
    return;
  }
  const name = document.getElementById('playerName')?.value.trim() || "Player";
  const tutor = document.getElementById('tutorName')?.value.trim() || "Tutor";
  const r = window._lastResult;

  let freeResponses = [];
  document.querySelectorAll('.free-write').forEach((ta, i) => {
    if (ta.value.trim()) {
      freeResponses.push(`- Prompt ${i+1}: ${ta.value.trim()}`);
    }
  });

  let summary = `⚽ SPANISH FOR FOOTBALLERS — HOMEWORK REPORT\n`;
  summary += `Player: ${name} | Tutor: ${tutor}\n`;
  summary += `Topic: ${r.title}\n`;
  summary += `Auto-Graded Score: ${r.correct}/${r.total} (${r.pct}%)\n`;
  if (r.missed.length > 0) {
    summary += `Missed Items: ${r.missed.slice(0, 8).join(', ')}${r.missed.length > 8 ? '...' : ''}\n`;
  }
  if (freeResponses.length > 0) {
    summary += `\nWritten Sentences:\n${freeResponses.join('\n')}`;
  }

  navigator.clipboard.writeText(summary).then(() => {
    alert("Copied to clipboard! Paste it directly into WhatsApp or email for your tutor.");
  });
}
</script>
</body>
</html>
